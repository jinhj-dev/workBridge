# cp .env.test.example .env.test でコピーし、値を設定する(.env.test は Git に含めない)
# e2e テスト用。開発用 DB(workbridge)ではなく workbridge_test を使う
NODE_ENV=test
PORT=6000
DATABASE_URL=postgresql://workbridge:<パスワード>@localhost:5432/workbridge_test
# Access Token の署名用。32 文字以上のランダムな文字列(例: openssl rand -base64 48)
JWT_ACCESS_SECRET=
