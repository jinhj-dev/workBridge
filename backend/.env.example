# cp .env.example .env でコピーし、値を設定する(.env は Git に含めない)
NODE_ENV=development
PORT=4000
# ルートの .env(docker compose)と同じユーザー・パスワードを使う
DATABASE_URL=postgresql://workbridge:<パスワード>@localhost:5432/workbridge
# 初期データ投入(npm run db:seed)用。SEED_ADMIN_PASSWORD は必須(8 文字以上、英字と数字を含む、72 バイト以下)
# 初期 ADMIN は活性 ADMIN が 1 人もいないときだけ登録する
SEED_ADMIN_PASSWORD=
# 数字のみ(最大 50 桁、先頭の 0 は保持)。未設定なら 00001
SEED_ADMIN_EMP_ID=
SEED_ADMIN_NAME=
# Access Token の署名用。32 文字以上のランダムな文字列(例: openssl rand -base64 48)
JWT_ACCESS_SECRET=
# E2E アカウント(npm run db:e2e-accounts)用。開発 DB 専用で、本番(NODE_ENV=production)では実行できない
# 規則は SEED_ADMIN_PASSWORD と同じ。Playwright 実行時にも同じ値を環境変数で渡す
E2E_ADMIN_PASSWORD=
E2E_INITIAL_PASSWORD=
